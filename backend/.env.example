# ==========================================
# Electronics E-Commerce Backend Environment
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="TechGadgets Store API"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electronics_ecommerce?schema=public"

# Admin Authentication / JWT
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880 # 5MB in bytes

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_CURRENCY=LKR
PAYHERE_BASE_URL="https://sandbox.payhere.lk/pay/checkout"

# WhatsApp Business Order Notification
WHATSAPP_BUSINESS_NUMBER="94771234567"
